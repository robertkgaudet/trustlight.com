---
import SiteLayout from '../layouts/SiteLayout.astro';

const services = [
  {
    idx: '01',
    title: 'AI for business',
    blurb:
      'Operating leverage for owner-led companies. We turn document-heavy work — estimates, leases, compliance files — into AI workflows your team checks instead of produces.',
  },
  {
    idx: '02',
    title: 'Advisory for nonprofits',
    blurb:
      'Fundability, donor strategy, board operations, and AI integration for mission-driven organizations.',
  },
];

const stats = [
  { figure: '60', label: 'Years combined experience' },
  { figure: '30', label: 'Years software & technology leadership' },
  { figure: '30', label: 'Years Louisiana business leadership' },
  { figure: '10', label: 'Years running a nonprofit' },
  { figure: '3', label: 'Years building agentic AI systems' },
];
---
<SiteLayout
  title="Trustlight — AI Integration & Nonprofit Advisory in South Louisiana"
  description="A husband-and-wife advisory team helping Louisiana businesses and nonprofits understand and implement AI that pays for itself. Lafayette, Baton Rouge, New Orleans."
>
  <!-- Masthead — report-style, left aligned, one primary action -->
  <section class="shell masthead">
    <span class="eyebrow">Trustlight · South Louisiana</span>
    <h1>We help Louisiana organizations understand and implement AI that pays for itself.</h1>
    <p class="lead">
      Trustlight is a husband-and-wife advisory team. We find the workflow bottlenecks
      costing you time and money, and we build the systems that remove them.
    </p>
    <div class="actions">
      <a class="btn" href="/contact">Start a conversation</a>
    </div>
  </section>

  <!-- Services overview — hairline-divided grid, each links to /services -->
  <section class="shell section" aria-labelledby="svc-head">
    <div class="section-head">
      <span class="eyebrow">What we do</span>
      <h2 id="svc-head">Services</h2>
    </div>
    <div class="svc-grid">
      {services.map((s) => (
        <a class="svc-cell" href="/services">
          <span class="idx num">{s.idx}</span>
          <h3>{s.title}</h3>
          <p>{s.blurb}</p>
          <span class="more">View services →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Credibility band — figures in Plex Mono tabular -->
  <section class="credibility" aria-labelledby="proof-head">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Track record</span>
        <h2 id="proof-head">Built on experience that compounds.</h2>
      </div>
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-figure">{s.figure}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing contact prompt -->
  <section class="shell section" aria-labelledby="contact-cta">
    <div class="cta-band">
      <h2 id="contact-cta">Tell us where the work is piling up. We’ll tell you what’s possible.</h2>
      <a class="btn" href="/contact">Start a conversation</a>
    </div>
  </section>
</SiteLayout>
