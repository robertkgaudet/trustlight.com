---
import SiteLayout from '../layouts/SiteLayout.astro';

const business = [
  {
    problem:
      'Your team spends weeks turning 200-page leases, estimates, and compliance documents into something usable. Skilled people doing slow work a system could do in minutes — and the backlog never clears.',
    solution:
      'We build the AI workflow that does the first pass in minutes, so your people review output instead of producing it.',
  },
  {
    problem:
      'You’re growing, and the only lever anyone offers you is “hire more people.” Every new contract strains the same operating model, and headcount eats the margin growth was supposed to create.',
    solution:
      'We find the operating leverage in your document-heavy workflows so growth doesn’t mean proportional hiring.',
  },
  {
    problem:
      'The big consultancies won’t show up for a company your size, and the AI vendors want to sell you a platform, not a result. You’re left to sort what’s real from what’s hype on your own.',
    solution:
      'We’re local, we scope to your business, and we measure success in dollars saved or made.',
  },
];

const nonprofit = [
  {
    problem:
      'You’ve submitted application after application and heard nothing back — and no one will tell you why. The mission is strong, the need is real, and still the answer is no.',
    solution:
      'We diagnose the pattern across your submissions and find what funders are actually responding to.',
  },
  {
    problem:
      'Funders research your board, your financials, and your partnerships before they ever call. They form an impression from documents you can’t see — and you never get to answer it.',
    solution:
      'We assess your fundability the way a funder would, then close the gaps before you apply again.',
  },
  {
    problem:
      'Your materials lead with the need in the community, when funders are deciding whether they can trust you to deliver. The language meant to move them is quietly working against you.',
    solution:
      'We reposition your story so it signals capacity and credibility, not just cause — and we bring the same AI leverage to your operations.',
  },
];
---
<SiteLayout
  title="Services — AI for Business & Nonprofit Advisory"
  description="AI workflow integration for owner-led businesses, and fundability, donor, and board advisory for nonprofits across South Louisiana."
>
  <section class="shell masthead">
    <span class="eyebrow">Services</span>
    <h1>What we do, and why it matters.</h1>
    <p class="lead">
      AI workflow integration for owner-led businesses, and fundability, donor, and board
      advisory for nonprofits across South Louisiana.
    </p>
  </section>

  <section class="shell section" aria-labelledby="biz-head">
    <div class="svc-block">
      <div class="section-head">
        <span class="eyebrow">For business</span>
        <h2 id="biz-head">AI for business</h2>
      </div>
      <div class="pain-list">
        {business.map((p) => (
          <article class="pain">
            <p class="problem">{p.problem}</p>
            <p class="solution"><span class="arrow" aria-hidden="true">→</span>{p.solution}</p>
          </article>
        ))}
      </div>
      <div class="actions">
        <a class="btn" href="/contact">Start a conversation</a>
      </div>
    </div>
  </section>

  <section class="shell section" aria-labelledby="np-head">
    <div class="svc-block">
      <div class="section-head">
        <span class="eyebrow">For nonprofits</span>
        <h2 id="np-head">Advisory for nonprofits</h2>
      </div>
      <div class="pain-list">
        {nonprofit.map((p) => (
          <article class="pain">
            <p class="problem">{p.problem}</p>
            <p class="solution"><span class="arrow" aria-hidden="true">→</span>{p.solution}</p>
          </article>
        ))}
      </div>
      <div class="actions">
        <a class="btn" href="/contact">Start a conversation</a>
      </div>
    </div>
  </section>
</SiteLayout>
