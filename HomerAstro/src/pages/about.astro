---
import SiteLayout from '../layouts/SiteLayout.astro';

const team = [
  {
    src: '/assets/images/camille.jpg',
    w: 1069, h: 1280,
    alt: 'Camille Gaudet, nonprofit advisor',
    name: 'Camille Gaudet',
    role: 'Nonprofit Advisory & Business Leadership',
  },
  {
    src: '/assets/images/rob.jpg',
    w: 896, h: 1200,
    alt: 'Rob Gaudet, AI integration lead',
    name: 'Rob Gaudet',
    role: 'AI Integration & Technology Leadership',
  },
];
---
<SiteLayout
  title="About Trustlight — Camille & Rob Gaudet"
  description="Sixty years of combined operating experience. A South Louisiana husband-and-wife team helping organizations implement AI with measurable ROI."
>
  <section class="shell masthead">
    <span class="eyebrow">About Trustlight</span>
    <h1>A husband-and-wife advisory team.</h1>
  </section>

  <section class="shell section" aria-label="Who we are">
    <div class="prose">
      <p class="lead">
        Trustlight is Camille and Rob Gaudet — a husband-and-wife advisory team based in
        South Louisiana. We were married in New Orleans in 2023, and we work the way we
        married: side by side, solving the same problem from different angles.
      </p>
      <p>
        Between us we bring sixty years of operating experience. Rob has spent thirty years
        in software engineering and technology leadership, has led several businesses, and
        for the past three years has been building fully agentic AI systems. Camille has
        spent thirty years as a business leader in Louisiana and, for the last decade, has
        run a nonprofit — which means she understands both the operator’s pressures and the
        mission-driven organization’s. Together, we help organizations understand and
        implement AI that pays for itself.
      </p>
      <p>
        Our work is unglamorous on purpose. We find the place where your people spend weeks
        on work a system could do in minutes — the estimate, the lease, the compliance file,
        the grant application — and we build the workflow that removes the bottleneck. We
        have helped companies save and make millions of dollars doing exactly this.
      </p>
      <p>
        We serve the organizations the large consultancies overlook: the owner-led business
        and the working nonprofit, across Lafayette, Baton Rouge, and New Orleans. Same
        standard of rigor for both.
      </p>
    </div>
  </section>

  <section class="shell section" aria-labelledby="team-head">
    <div class="section-head">
      <span class="eyebrow">The team</span>
      <h2 id="team-head">Camille &amp; Rob</h2>
    </div>
    <div class="team">
      {team.map((m) => (
        <figure>
          <img class="team-photo" src={m.src} alt={m.alt} width={m.w} height={m.h} loading="lazy" decoding="async" />
          <figcaption>
            <span class="team-name">{m.name}</span>
            <span class="team-role">{m.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="shell section" aria-labelledby="about-cta">
    <div class="cta-band">
      <h2 id="about-cta">Tell us where the work is piling up.</h2>
      <a class="btn" href="/contact">Start a conversation</a>
    </div>
  </section>
</SiteLayout>
