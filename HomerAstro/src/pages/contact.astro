---
import SiteLayout from '../layouts/SiteLayout.astro';
// NOTE: form `action` is a placeholder — wire to a real endpoint before launch.
const FORM_ACTION = 'https://formspree.io/f/your-form-id';
---
<SiteLayout
  title="Contact Trustlight"
  description="Start a conversation about AI integration or nonprofit advisory in Lafayette, Baton Rouge, or New Orleans."
>
  <section class="shell masthead">
    <span class="eyebrow">Contact</span>
    <h1>Tell us where the work is piling up.</h1>
    <p class="lead">
      Start a conversation about AI integration or nonprofit advisory in Lafayette,
      Baton Rouge, or New Orleans.
    </p>
  </section>

  <section class="shell section" aria-label="Contact">
    <div class="contact-grid">
      <!-- Restrained form: name, email, message. Rectangular, hairline fields. -->
      <form method="post" action={FORM_ACTION} aria-labelledby="form-head">
        <h2 id="form-head" class="visually-hidden">Send a message</h2>

        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>

        <button class="btn" type="submit">Send message</button>
      </form>

      <!-- Direct contact details alongside (public address only) -->
      <aside aria-label="Direct contact">
        <dl class="contact-detail">
          <dt>Email</dt>
          <dd><a href="mailto:hello@trustlight.com">hello@trustlight.com</a></dd>
        </dl>
        <dl class="contact-detail">
          <dt>Phone</dt>
          <dd><a class="num" href="tel:+15043028656">504-302-8656</a></dd>
        </dl>
        <dl class="contact-detail">
          <dt>Serving</dt>
          <dd>Lafayette, Baton Rouge, and New Orleans.</dd>
        </dl>
      </aside>
    </div>
  </section>
</SiteLayout>
