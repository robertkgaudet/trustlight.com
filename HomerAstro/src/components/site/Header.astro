---
// Trustlight site header — T monogram + TRUSTLIGHT wordmark lockup (left),
// nav (right). Hairline bottom border, no shadow. (Victora / Old-Money Ledger)
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="site-header">
  <div class="shell">
    <a class="lockup" href="/" aria-label="Trustlight — home">
      <span class="monogram" aria-hidden="true">T</span>
      <span class="wordmark">Trustlight</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
