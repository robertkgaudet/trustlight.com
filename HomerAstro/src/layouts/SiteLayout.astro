---
// Trustlight public-site layout — clean, standalone Victora layer.
// Deliberately does NOT load any admin CSS/JS. Fast, accessible, SEO-clean.
import '../styles/victora.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  /** Full, verbatim <title> (already includes "Trustlight"). */
  title: string;
  description: string;
  /** Override the canonical/og path; defaults to the current route. */
  path?: string;
}

const SITE = 'https://trustlight.com';
const OG_IMAGE = `${SITE}/assets/images/trustlightlogo.jpg`; // 1408 x 1408
const { title, description, path } = Astro.props;

const pathname = (path ?? Astro.url.pathname).replace(/\/+$/, '') || '/';
const canonical = SITE + (pathname === '/' ? '' : pathname);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Trustlight',
  description:
    'A husband-and-wife advisory team helping South Louisiana businesses and nonprofits understand and implement AI that pays for itself.',
  url: SITE,
  image: OG_IMAGE,
  email: 'hello@trustlight.com',
  telephone: '+1-504-302-8656',
  areaServed: [
    { '@type': 'City', name: 'Lafayette' },
    { '@type': 'City', name: 'Baton Rouge' },
    { '@type': 'City', name: 'New Orleans' },
    { '@type': 'AdministrativeArea', name: 'South Louisiana' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'AI integration for business',
          description:
            'Turning document-heavy work into AI workflows that give owner-led companies operating leverage.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Nonprofit advisory',
          description:
            'Fundability, donor strategy, board operations, and AI integration for mission-driven organizations.',
        },
      },
    ],
  },
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicons (generated from trustlightlogo.jpg) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trustlight" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1408" />
    <meta property="og:image:height" content="1408" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta name="theme-color" content="#FBFAF7" />

    <!-- Type: IBM Plex Sans (display + body) + IBM Plex Mono (figures/labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
